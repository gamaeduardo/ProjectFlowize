PUBLIC_SITE_URL=https://flowizehub.com
PUBLIC_UMAMI_WEBSITE_ID=

# Hostnames onde o Umami conta visitas (lista separada por vírgula).
# Enquanto o domínio não está conectado, inclua o subdomínio do Netlify:
# PUBLIC_UMAMI_DOMAINS=flowizehub.com,www.flowizehub.com,flowizehub.netlify.app
PUBLIC_UMAMI_DOMAINS=

# Opcional: lê os clientes do Supabase no build.
# Sem estas variáveis o build usa src/data/clientes/*.json.
# Não use o prefixo PUBLIC_: são segredos de build.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
