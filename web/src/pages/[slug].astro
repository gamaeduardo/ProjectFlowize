---
import Base from '../layouts/Base.astro';
import Completo from '../components/menu/Completo.astro';
import Simples from '../components/menu/Simples.astro';
import { getClientes } from '../lib/clients';
import { cssVars } from '../lib/theme';
import type { MenuConfig } from '../lib/schema';

export async function getStaticPaths() {
  const clientes = await getClientes();
  return clientes.map(({ slug, cfg }) => ({ params: { slug }, props: { cfg } }));
}

interface Props {
  cfg: MenuConfig;
}

const { cfg } = Astro.props;
const slug = Astro.params.slug!;
const ativo = cfg.status === 'ativo';
const inativo = cfg.status === 'inativo';

const title = `${cfg.nome} · Cardápio`;
const description =
  cfg.slogan || `Cardápio digital de ${cfg.nome}. Monte seu pedido e envie pelo WhatsApp.`;

const site = Astro.site ?? new URL('https://flowizehub.com');
const url = new URL(`/${slug}`, site).href;
const imagem = new URL(`/og/${slug}.png`, site).href;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: cfg.nome,
  description,
  url,
  image: imagem,
  hasMenu: url,
  ...(cfg.whatsapp ? { telephone: `+${cfg.whatsapp}` } : {}),
  ...(cfg.endereco
    ? { address: { '@type': 'PostalAddress', streetAddress: cfg.endereco } }
    : {}),
  ...(cfg.horario ? { openingHours: `Mo-Su ${cfg.horario.abre}-${cfg.horario.fecha}` } : {}),
};

const cores = cssVars(cfg.cores);

// Contador próprio de visitas: só usa a chave pública (o RLS protege o resto).
// O Umami continua sendo a fonte de detalhe; isto é o resumo por cardápio.
// Conta também `teste` (o link já pode estar circulando) e ignora `inativo`.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
const contarVisitas = !inativo && Boolean(supabaseUrl && supabaseKey);

if (!inativo && !contarVisitas) {
  console.warn(
    '[Flowize] contador de visitas desligado: defina PUBLIC_SUPABASE_URL e PUBLIC_SUPABASE_KEY.',
  );
}
---

<Base
  title={title}
  description={description}
  image={`/og/${slug}.png`}
  robots={ativo ? 'index,follow' : 'noindex,nofollow'}
  jsonLd={jsonLd}
  umamiId={cfg.analytics_website_id}
>
  {
    cores && (
      <Fragment slot="head">
        <style is:inline set:html={`:root{${cores}}`}></style>
      </Fragment>
    )
  }

  {
    inativo ? (
      <div class="aviso">
        <div>
          <h1>{cfg.nome}</h1>
          <p>Este cardápio está temporariamente indisponível.</p>
        </div>
      </div>
    ) : cfg.pacote === 'simples' ? (
      <Simples cfg={cfg} slug={slug} />
    ) : (
      <Completo cfg={cfg} slug={slug} />
    )
  }

  {
    contarVisitas && (
      <script is:inline define:vars={{ slug, supabaseUrl, supabaseKey }}>
        (() => {
          if (!supabaseUrl || !supabaseKey) return;
          if (navigator.webdriver) return;
          if (navigator.doNotTrack === '1') return;
          if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;

          const chave = 'flowize:visita:' + slug;
          try {
            if (sessionStorage.getItem(chave)) return;
            sessionStorage.setItem(chave, '1');
          } catch {
            // Modo privado: conta uma vez por carregamento.
          }

          fetch(supabaseUrl.replace(/\/+$/, '') + '/rest/v1/rpc/registrar_visita', {
            method: 'POST',
            mode: 'cors',
            keepalive: true,
            headers: {
              'content-type': 'application/json',
              apikey: supabaseKey,
              authorization: 'Bearer ' + supabaseKey,
            },
            body: JSON.stringify({ p_slug: slug }),
          }).catch(() => {
            // Sem rede ou Supabase fora do ar: a visita simplesmente não conta.
          });
        })();
      </script>
    )
  }
</Base>

<style is:global>
  .aviso{min-height:100dvh;display:grid;place-content:center;text-align:center;padding:24px;font:16px/1.5 system-ui,sans-serif;color:#222;background:#fff}
  .aviso h1{font-size:2rem;margin:0 0 8px}
  .aviso p{margin:0;color:#666}
</style>
