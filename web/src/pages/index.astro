---
import Base from '../layouts/Base.astro';
import Marca from '../components/marca/Marca.astro';
import Cardapinho from '../components/landing/Cardapinho.astro';
import { getClientes } from '../lib/clients';
import { site, siteUrl, waLink } from '../lib/site';

const exemplos = (await getClientes()).filter(({ cfg }) => cfg.status !== 'inativo');

const faq = [
  {
    pergunta: 'Preciso instalar algum aplicativo?',
    resposta:
      'Não. Seu cliente abre o cardápio pelo link ou lê o QR code no celular. O pedido chega no WhatsApp que você já usa, sem instalar nada.',
  },
  {
    pergunta: 'A Flowize cobra comissão por pedido?',
    resposta:
      'Não. Você paga a mensalidade do plano e recebe os pedidos direto no seu WhatsApp. Não existe percentual por venda.',
  },
  {
    pergunta: 'Quanto tempo leva para o cardápio ficar pronto?',
    resposta:
      'Normalmente poucos dias úteis depois que você envia os itens, preços e fotos. A gente combina o prazo certinho no WhatsApp.',
  },
  {
    pergunta: 'Como atualizo preços, fotos e itens?',
    resposta:
      'Por enquanto é só chamar a gente no WhatsApp. Em breve você vai poder editar tudo por um painel próprio.',
  },
  {
    pergunta: 'Meu cardápio aparece no Google?',
    resposta:
      'Se você quiser, sim. Páginas em teste ficam fora do Google até você aprovar a publicação.',
  },
  {
    pergunta: 'Vocês fazem site e outras coisas?',
    resposta:
      'Sim. Além do cardápio digital, a Flowize faz sites e bots para pequenos negócios. Fale com a gente para entender o que faz sentido para o seu momento.',
  },
  {
    pergunta: 'Como funciona o pagamento?',
    resposta:
      'É mensal e combinado direto no WhatsApp. Sem comissão por pedido e sem taxa escondida.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organizacao`,
      name: site.nome,
      url: `${siteUrl}/`,
      description:
        'Cardápios digitais com pedido direto no WhatsApp para pequenos negócios.',
      areaServed: { '@type': 'Country', name: 'Brasil' },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: `+${site.whatsapp}`,
        availableLanguage: ['Portuguese'],
      },
      ...(site.instagram ? { sameAs: [`https://instagram.com/${site.instagram}`] } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#site`,
      url: `${siteUrl}/`,
      name: site.nome,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${siteUrl}/#organizacao` },
    },
    {
      '@type': 'Service',
      name: 'Cardápio digital com pedido no WhatsApp',
      serviceType: 'Cardápio digital',
      provider: { '@id': `${siteUrl}/#organizacao` },
      areaServed: { '@type': 'Country', name: 'Brasil' },
      description:
        'Página leve com link próprio e QR code, carrinho e envio do pedido direto no WhatsApp, sem comissão por venda.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ pergunta, resposta }) => ({
        '@type': 'Question',
        name: pergunta,
        acceptedAnswer: { '@type': 'Answer', text: resposta },
      })),
    },
  ],
};

const ctaPrincipal = waLink('Olá! Quero um cardápio digital para o meu negócio.');
const ctaOrcamento = waLink('Olá! Quero um orçamento de cardápio digital.');
const ctaCompleto = waLink('Olá! Quero o pacote completo de cardápio digital.');
const ano = new Date().getFullYear();
---

<Base
  title="Flowize — cardápio digital com pedido no WhatsApp"
  description="Cardápio digital com link próprio, QR code e pedido no WhatsApp. Sem comissão e sem aplicativo. Para pizzarias, lanchonetes, docerias e delivery de bairro."
  jsonLd={jsonLd}
>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="cabecalho">
    <div class="container cabecalho-interno">
      <Marca />
      <nav class="nav" aria-label="Navegação principal">
        <a href="#como-funciona">Como funciona</a>
        <a href="#recursos">Recursos</a>
        <a href="#exemplos">Exemplos</a>
        <a href="#pacotes">Pacotes</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-primario btn-pequeno" href={ctaPrincipal} data-wa target="_blank" rel="noopener">
        Falar no WhatsApp
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero">
      <div class="container hero-grade">
        <div class="hero-texto">
          <span class="eyebrow"><i></i> Cardápio digital para pequenos negócios</span>
          <h1>Seu cardápio digital, com pedido direto no WhatsApp.</h1>
          <p>
            Um link próprio, leve e bonito para o cliente escolher o que quer e enviar o pedido
            pra você. Sem comissão por venda, sem aplicativo e sem depender de marketplace.
          </p>
          <div class="acoes">
            <a class="btn btn-primario" href={ctaPrincipal} data-wa target="_blank" rel="noopener">
              Quero meu cardápio
            </a>
            <a class="btn btn-secundario" href="/pizzaria-do-joao">Ver um exemplo</a>
          </div>
          <ul class="provas">
            <li>Pronto em poucos dias</li>
            <li>Seu link e seu QR code</li>
            <li>Pedido no seu WhatsApp</li>
          </ul>
        </div>

        <Cardapinho />
      </div>
    </section>

    <section class="secao secao-papel">
      <div class="container">
        <div class="titulo-secao">
          <h2>Seu cliente quer pedir. Não quer baixar app.</h2>
          <p>
            Cada etapa a mais é um pedido que não chega. PDF pesado, print perdido na conversa e
            comissão de aplicativo atrapalham quem já decidiu comprar.
          </p>
        </div>

        <div class="duelo">
          <article class="ruim">
            <h3>Do jeito antigo</h3>
            <ul>
              <li><span class="marca-x" aria-hidden="true">×</span> Cardápio em PDF que ninguém abre no celular.</li>
              <li><span class="marca-x" aria-hidden="true">×</span> Preço e foto espalhados no meio da conversa.</li>
              <li><span class="marca-x" aria-hidden="true">×</span> Pedido chegando em texto solto, sem quantidade.</li>
              <li><span class="marca-x" aria-hidden="true">×</span> Comissão em cada venda no marketplace.</li>
            </ul>
          </article>

          <article class="bom">
            <h3>Com a Flowize</h3>
            <ul>
              <li><span class="marca-v" aria-hidden="true">✓</span> Um link leve que abre em segundos.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> Itens com descrição, preço e imagem.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> Carrinho que monta a mensagem pronta.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> Pedido direto no seu WhatsApp.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> QR code para mesa, balcão e embalagem.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="secao secao-branca" id="recursos">
      <div class="container">
        <div class="titulo-secao">
          <h2>Tudo o que o cardápio precisa. Nada que atrapalhe.</h2>
          <p>
            A página é rápida, funciona sem app e foi feita para quem pede pelo celular — do
            primeiro acesso ao pedido no WhatsApp.
          </p>
        </div>

        <div class="recursos">
          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"/><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5"/></svg>
            </span>
            <h3>Link próprio</h3>
            <p>Seu cardápio em <b>flowizehub.com/seunome</b>, fácil de colocar na bio do Instagram.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.5 10.5h7M8.5 14h4.5"/></svg>
            </span>
            <h3>Pedido no WhatsApp</h3>
            <p>O carrinho monta a mensagem com itens, quantidade, entrega e forma de pagamento.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 0-4h-1.4a1.8 1.8 0 0 1 0-3.6h3.4A4.8 4.8 0 0 0 20 8.6 5.6 5.6 0 0 0 14.4 3H12Z"/><circle cx="7.8" cy="10" r=".9"/><circle cx="11" cy="7" r=".9"/><circle cx="15" cy="8" r=".9"/></svg>
            </span>
            <h3>Seu visual</h3>
            <p>Cores, logo e fotos do seu negócio. Dois modelos: simples e completo.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M19 5 5 19"/></svg>
            </span>
            <h3>Sem comissão</h3>
            <p>O pedido cai direto no seu WhatsApp. Você não paga percentual por venda.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13l1-8Z"/></svg>
            </span>
            <h3>Rápido no celular</h3>
            <p>Página leve, sem aplicativo e pronta para abrir no celular.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20h1"/></svg>
            </span>
            <h3>QR code incluído</h3>
            <p>Imprima e coloque na mesa, no balcão ou na embalagem para o cliente abrir na hora.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="secao secao-suave" id="como-funciona">
      <div class="container">
        <div class="titulo-secao">
          <h2>Do seu cardápio para o celular do cliente em três passos.</h2>
          <p>Sem instalar nada, sem treinar equipe e sem mudar o número que você já usa.</p>
        </div>

        <ol class="passos">
          <li class="passo">
            <span class="num">01</span>
            <h3>Você manda o cardápio</h3>
            <p>Itens, preços, fotos e o WhatsApp que vai receber os pedidos. Se já tiver tudo pronto, melhor ainda.</p>
          </li>
          <li class="passo">
            <span class="num">02</span>
            <h3>A gente monta a página</h3>
            <p>Seu link, seu QR code e uma prévia para você aprovar antes de divulgar.</p>
          </li>
          <li class="passo">
            <span class="num">03</span>
            <h3>Divulgue e receba pedidos</h3>
            <p>Coloque o link na bio e o QR no balcão. O pedido chega pronto no seu WhatsApp.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="secao secao-branca" id="exemplos">
      <div class="container">
        <div class="titulo-secao">
          <h2>Veja como fica na prática.</h2>
          <p>
            Dois pacotes, dois estilos. O seu cardápio leva o seu nome, as suas cores e o seu
            WhatsApp.
          </p>
        </div>

        <div class="exemplos">
          {
            exemplos.map(({ slug, cfg }) => (
              <a class="exemplo" href={`/${slug}`}>
                <span class="previa">
                  <img
                    src={`/exemplos/${slug}.png`}
                    alt={`Prévia do cardápio de ${cfg.nome}`}
                    width="390"
                    height="826"
                    loading="lazy"
                  />
                </span>
                <div class="corpo">
                  <span class="selo">
                    {cfg.pacote === 'completo' ? 'Pacote completo' : 'Pacote simples'}
                  </span>
                  <h3>{cfg.nome}</h3>
                  <p>{cfg.slogan || 'Cardápio digital'}</p>
                  <span class="abrir">
                    Abrir cardápio
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <p class="nota">
          São páginas de demonstração. O seu cardápio leva o seu nome, suas cores e seu WhatsApp.
        </p>
      </div>
    </section>

    <section class="secao secao-papel" id="pacotes">
      <div class="container">
        <div class="titulo-secao">
          <h2>Escolha o ponto de partida.</h2>
          <p>
            Os dois pacotes incluem link próprio, QR code e pedido no WhatsApp. O que muda é o
            nível de detalhe do cardápio.
          </p>
        </div>

        <div class="pacotes">
          <article class="pacote">
            <h3>Simples</h3>
            <p class="resumo">Para quem quer começar rápido e sem complicação.</p>
            <ul>
              <li>Cardápio com categorias e itens</li>
              <li>Preços e descrições</li>
              <li>Carrinho com envio no WhatsApp</li>
              <li>Link próprio e QR code</li>
              <li>Página leve e responsiva</li>
              <li>Ajustes pelo WhatsApp</li>
            </ul>
            <div class="preco">
              <b>Sob consulta</b>
              <small>Orçamento sem compromisso no WhatsApp.</small>
              <a class="btn btn-contorno" href={ctaOrcamento} data-wa target="_blank" rel="noopener">
                Pedir orçamento
              </a>
            </div>
          </article>

          <article class="pacote destaque">
            <span class="etiqueta">Mais completo</span>
            <h3>Completo</h3>
            <p class="resumo">Para vender mais e passar confiança em cada detalhe.</p>
            <ul>
              <li>Tudo do pacote Simples</li>
              <li>Fotos ou ilustrações dos itens</li>
              <li>Seção “Mais pedidos”</li>
              <li>Entrega, retirada, taxa e horário</li>
              <li>Endereço e formas de pagamento</li>
              <li>Observações por item</li>
            </ul>
            <div class="preco">
              <b>Sob consulta</b>
              <small>Mensalidade sem comissão por pedido.</small>
              <a class="btn btn-primario" href={ctaCompleto} data-wa target="_blank" rel="noopener">
                Quero o completo
              </a>
            </div>
          </article>
        </div>

        <p class="nota">
          Não sabe qual escolher? Manda o seu cardápio no WhatsApp que a gente indica o melhor
          pacote.
        </p>
      </div>
    </section>

    <section class="secao secao-branca" id="duvidas">
      <div class="container">
        <div class="titulo-secao">
          <h2>Dúvidas comuns.</h2>
          <p>Se a sua não estiver aqui, chama no WhatsApp.</p>
        </div>

        <div class="duvidas">
          {
            faq.map(({ pergunta, resposta }) => (
              <details>
                <summary>{pergunta}</summary>
                <p>{resposta}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao cta-final">
      <div class="container">
        <h2>Seu próximo pedido pode começar com um link.</h2>
        <p>
          Manda o nome do seu negócio e o cardápio. A gente monta uma prévia e mostra como fica
          antes de você decidir.
        </p>
        <a class="btn btn-primario btn-grande" href={ctaPrincipal} data-wa target="_blank" rel="noopener">
          Chamar no WhatsApp
        </a>
        <small>Atendimento em horário comercial. Sem compromisso.</small>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="container rodape-grade">
      <div class="rodape-marca">
        <Marca tom="claro" />
        <p>Cardápios digitais com pedido direto no WhatsApp. Feito com calma para pequenos negócios.</p>
      </div>

      <nav class="rodape-col" aria-label="Links do rodapé">
        <h2>Navegar</h2>
        <a href="#como-funciona">Como funciona</a>
        <a href="#recursos">Recursos</a>
        <a href="#exemplos">Exemplos</a>
        <a href="#pacotes">Pacotes</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>

      <div class="rodape-col">
        <h2>Contato</h2>
        <a href={ctaPrincipal} data-wa target="_blank" rel="noopener">
          WhatsApp · {site.whatsappExibicao}
        </a>
        {site.instagram && (
          <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
            Instagram
          </a>
        )}
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>

    <div class="container rodape-base">
      <span>© {ano} Flowize</span>
      <span>{site.dominio}</span>
    </div>
  </footer>

  <script>
    import { track } from '../lib/track';

    document.querySelectorAll<HTMLElement>('[data-wa]').forEach((link) => {
      link.addEventListener('click', () => track('Clique WhatsApp'));
    });
  </script>
</Base>

<style is:global>
  :root {
    --tinta: #1c1210;
    --tinta-2: #2a1c18;
    --papel: #fbf8f4;
    --papel-2: #f4ede4;
    --branco: #fff;
    --acento: #d62828;
    --acento-2: #b21f1f;
    --suave: #efe6da;
    --linha: #e6dbcd;
    --mudo: #6d625c;
    --verde: #1a8a4a;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  body {
    margin: 0;
    background: var(--papel);
    color: var(--tinta);
    font: 16px/1.55 'Instrument Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  .display {
    font-family: 'Bricolage Grotesque', 'Instrument Sans', system-ui, sans-serif;
    letter-spacing: -0.03em;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  :focus-visible {
    outline: 3px solid var(--acento);
    outline-offset: 3px;
  }

  .container {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  .pular {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: #fff;
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
  }

  .pular:focus {
    top: 16px;
  }

  /* Header */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--linha);
    background: color-mix(in srgb, var(--papel) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .cabecalho-interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 72px;
  }

  .nav {
    display: flex;
    gap: 22px;
    font-size: 0.94rem;
    font-weight: 500;
  }

  .nav a {
    color: var(--mudo);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--tinta);
  }

  /* Botões */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    font: 600 0.97rem/1 'Instrument Sans', system-ui, sans-serif;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primario {
    background: var(--acento);
    color: #fff;
  }

  .btn-primario:hover {
    background: var(--acento-2);
  }

  .btn-secundario {
    border-color: #ffffff3d;
    background: #ffffff0a;
    color: #fff;
  }

  .btn-secundario:hover {
    background: #ffffff16;
  }

  .btn-contorno {
    border-color: var(--tinta);
    color: var(--tinta);
    background: transparent;
  }

  .btn-contorno:hover {
    background: var(--tinta);
    color: #fff;
  }

  .btn-pequeno {
    padding: 11px 18px;
    font-size: 0.9rem;
  }

  .btn-grande {
    padding: 17px 30px;
    font-size: 1.05rem;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: clip;
    background: radial-gradient(120% 120% at 85% 8%, #6b1a14 0%, var(--tinta) 56%);
    color: #fff;
  }

  .hero-grade {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 56px;
    padding-block: clamp(56px, 8vw, 96px) clamp(64px, 9vw, 112px);
  }

  .hero-texto h1 {
    max-width: 15ch;
    margin: 20px 0 0;
    font-size: clamp(2.4rem, 5.6vw, 4.15rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero-texto p {
    max-width: 46ch;
    margin: 20px 0 0;
    color: #e8dcd5;
    font-size: clamp(1rem, 1.5vw, 1.16rem);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 13px;
    border: 1px solid #ffffff2b;
    border-radius: 999px;
    background: #ffffff0d;
    color: #f3e7df;
    font-size: 0.8rem;
