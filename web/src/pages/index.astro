---
import Base from '../layouts/Base.astro';
import Marca from '../components/marca/Marca.astro';
import Cardapinho from '../components/landing/Cardapinho.astro';
import { getClientes } from '../lib/clients';
import { site, siteUrl, waLink } from '../lib/site';

const exemplos = (await getClientes()).filter(({ cfg }) => cfg.status !== 'inativo');

const faixa = [
  'Sem comissão por pedido',
  'Link próprio',
  'QR code incluído',
  'Pedido no WhatsApp',
  'Seu visual',
  'Sem aplicativo',
];

const faq = [
  {
    pergunta: 'Preciso instalar algum aplicativo?',
    resposta:
      'Não. Seu cliente abre o cardápio pelo link ou lê o QR code no celular. O pedido chega no WhatsApp que você já usa, sem instalar nada.',
  },
  {
    pergunta: 'A Flowize cobra comissão por pedido?',
    resposta:
      'Não. Você paga a mensalidade do plano e recebe os pedidos direto no seu WhatsApp. Não existe percentual por venda.',
  },
  {
    pergunta: 'Quanto tempo leva para o cardápio ficar pronto?',
    resposta:
      'Normalmente poucos dias úteis depois que você envia os itens, preços e fotos. A gente combina o prazo certinho no WhatsApp.',
  },
  {
    pergunta: 'Como atualizo preços, fotos e itens?',
    resposta:
      'Por enquanto é só chamar a gente no WhatsApp. Em breve você vai poder editar tudo por um painel próprio.',
  },
  {
    pergunta: 'Meu cardápio aparece no Google?',
    resposta:
      'Se você quiser, sim. Páginas em teste ficam fora do Google até você aprovar a publicação.',
  },
  {
    pergunta: 'Vocês fazem site e outras coisas?',
    resposta:
      'Sim. Além do cardápio digital, a Flowize faz sites e bots para pequenos negócios. Fale com a gente para entender o que faz sentido para o seu momento.',
  },
  {
    pergunta: 'Como funciona o pagamento?',
    resposta:
      'É mensal e combinado direto no WhatsApp. Sem comissão por pedido e sem taxa escondida.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organizacao`,
      name: site.nome,
      url: `${siteUrl}/`,
      description:
        'Cardápios digitais com pedido direto no WhatsApp para pequenos negócios.',
      areaServed: { '@type': 'Country', name: 'Brasil' },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: `+${site.whatsapp}`,
        availableLanguage: ['Portuguese'],
      },
      ...(site.instagram ? { sameAs: [`https://instagram.com/${site.instagram}`] } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#site`,
      url: `${siteUrl}/`,
      name: site.nome,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${siteUrl}/#organizacao` },
    },
    {
      '@type': 'Service',
      name: 'Cardápio digital com pedido no WhatsApp',
      serviceType: 'Cardápio digital',
      provider: { '@id': `${siteUrl}/#organizacao` },
      areaServed: { '@type': 'Country', name: 'Brasil' },
      description:
        'Página leve com link próprio e QR code, carrinho e envio do pedido direto no WhatsApp, sem comissão por venda.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ pergunta, resposta }) => ({
        '@type': 'Question',
        name: pergunta,
        acceptedAnswer: { '@type': 'Answer', text: resposta },
      })),
    },
  ],
};

const ctaPrincipal = waLink('Olá! Quero um cardápio digital para o meu negócio.');
const ctaOrcamento = waLink('Olá! Quero um orçamento de cardápio digital.');
const ctaCompleto = waLink('Olá! Quero o pacote completo de cardápio digital.');
const ano = new Date().getFullYear();
---

<Base
  title="Flowize — cardápio digital com pedido no WhatsApp"
  description="Cardápio digital com link próprio, QR code e pedido no WhatsApp. Sem comissão e sem aplicativo. Para pizzarias, lanchonetes, docerias e delivery de bairro."
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="theme-color" content="#f6f6f8" />
  </Fragment>

  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="cabecalho">
    <div class="container cabecalho-interno">
      <Marca />
      <nav class="nav" aria-label="Navegação principal">
        <a href="#como-funciona">Como funciona</a>
        <a href="#recursos">Recursos</a>
        <a href="#exemplos">Exemplos</a>
        <a href="#pacotes">Pacotes</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <a class="btn btn-primario btn-pequeno" href={ctaPrincipal} data-wa target="_blank" rel="noopener">
        Falar no WhatsApp
      </a>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero">
      <div class="container hero-grade">
        <div class="hero-texto">
          <span class="eyebrow"><i></i> Cardápio digital para pequenos negócios</span>
          <h1>
            Seu cardápio digital, com pedido direto no{' '}
            <span class="glitch">WhatsApp<span class="glitch-copia ciano" aria-hidden="true">WhatsApp</span><span class="glitch-copia magenta" aria-hidden="true">WhatsApp</span></span>.
          </h1>
          <p>
            Um link próprio, leve e bonito para o cliente escolher o que quer e enviar o pedido
            pra você. Sem comissão por venda, sem aplicativo e sem depender de marketplace.
          </p>
          <div class="acoes">
            <a class="btn btn-primario" href={ctaPrincipal} data-wa target="_blank" rel="noopener">
              Quero meu cardápio
            </a>
            <a class="btn btn-secundario" href="/pizzaria-do-joao">Ver um exemplo</a>
          </div>
          <ul class="provas">
            <li>Pronto em poucos dias</li>
            <li>Seu link e seu QR code</li>
            <li>Pedido no seu WhatsApp</li>
          </ul>
        </div>

        <Cardapinho />
      </div>
    </section>

    <div class="faixa" aria-hidden="true">
      <div class="faixa-trilho">
        {
          [0, 1].map(() => (
            <div class="faixa-bloco">
              {faixa.map((texto) => (
                <span>
                  {texto}
                  <i />
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <section class="secao secao-papel">
      <div class="container">
        <div class="titulo-secao" data-revelar>
          <span class="rotulo"><i></i> O problema</span>
          <h2>Seu cliente quer pedir. Não quer baixar app.</h2>
          <p>
            Cada etapa a mais é um pedido que não chega. PDF pesado, print perdido na conversa e
            comissão de aplicativo atrapalham quem já decidiu comprar.
          </p>
        </div>

        <div class="duelo">
          <article class="ruim">
            <h3>Do jeito antigo</h3>
            <ul>
              <li><span class="marca-x" aria-hidden="true">×</span> Cardápio em PDF que ninguém abre no celular.</li>
              <li><span class="marca-x" aria-hidden="true">×</span> Preço e foto espalhados no meio da conversa.</li>
              <li><span class="marca-x" aria-hidden="true">×</span> Pedido chegando em texto solto, sem quantidade.</li>
              <li><span class="marca-x" aria-hidden="true">×</span> Comissão em cada venda no marketplace.</li>
            </ul>
          </article>

          <article class="bom">
            <h3>Com a Flowize</h3>
            <ul>
              <li><span class="marca-v" aria-hidden="true">✓</span> Um link leve que abre em segundos.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> Itens com descrição, preço e imagem.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> Carrinho que monta a mensagem pronta.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> Pedido direto no seu WhatsApp.</li>
              <li><span class="marca-v" aria-hidden="true">✓</span> QR code para mesa, balcão e embalagem.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="secao secao-branca" id="recursos">
      <div class="container">
        <div class="titulo-secao" data-revelar>
          <span class="rotulo"><i></i> O que vem junto</span>
          <h2>Tudo o que o cardápio precisa. Nada que atrapalhe.</h2>
          <p>
            A página é rápida, funciona sem app e foi feita para quem pede pelo celular — do
            primeiro acesso ao pedido no WhatsApp.
          </p>
        </div>

        <div class="recursos">
          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"/><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5"/></svg>
            </span>
            <h3>Link próprio</h3>
            <p>Seu cardápio em <b>flowizehub.com/seunome</b>, fácil de colocar na bio do Instagram.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.5 10.5h7M8.5 14h4.5"/></svg>
            </span>
            <h3>Pedido no WhatsApp</h3>
            <p>O carrinho monta a mensagem com itens, quantidade, entrega e forma de pagamento.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 0-4h-1.4a1.8 1.8 0 0 1 0-3.6h3.4A4.8 4.8 0 0 0 20 8.6 5.6 5.6 0 0 0 14.4 3H12Z"/><circle cx="7.8" cy="10" r=".9"/><circle cx="11" cy="7" r=".9"/><circle cx="15" cy="8" r=".9"/></svg>
            </span>
            <h3>Seu visual</h3>
            <p>Cores, logo e fotos do seu negócio. Dois modelos: simples e completo.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M19 5 5 19"/></svg>
            </span>
            <h3>Sem comissão</h3>
            <p>O pedido cai direto no seu WhatsApp. Você não paga percentual por venda.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10H13l1-8Z"/></svg>
            </span>
            <h3>Rápido no celular</h3>
            <p>Página leve, sem aplicativo e pronta para abrir no celular.</p>
          </article>

          <article class="recurso">
            <span class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20h1"/></svg>
            </span>
            <h3>QR code incluído</h3>
            <p>Imprima e coloque na mesa, no balcão ou na embalagem para o cliente abrir na hora.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="secao secao-suave" id="como-funciona">
      <div class="container">
        <div class="titulo-secao" data-revelar>
          <span class="rotulo"><i></i> Como funciona</span>
          <h2>Do seu cardápio para o celular do cliente em três passos.</h2>
          <p>Sem instalar nada, sem treinar equipe e sem mudar o número que você já usa.</p>
        </div>

        <ol class="passos">
          <li class="passo">
            <span class="num">01</span>
            <h3>Você manda o cardápio</h3>
            <p>Itens, preços, fotos e o WhatsApp que vai receber os pedidos. Se já tiver tudo pronto, melhor ainda.</p>
          </li>
          <li class="passo">
            <span class="num">02</span>
            <h3>A gente monta a página</h3>
            <p>Seu link, seu QR code e uma prévia para você aprovar antes de divulgar.</p>
          </li>
          <li class="passo">
            <span class="num">03</span>
            <h3>Divulgue e receba pedidos</h3>
            <p>Coloque o link na bio e o QR no balcão. O pedido chega pronto no seu WhatsApp.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="secao secao-branca" id="exemplos">
      <div class="container">
        <div class="titulo-secao" data-revelar>
          <span class="rotulo"><i></i> Na prática</span>
          <h2>Veja como fica na prática.</h2>
          <p>
            Dois pacotes, dois estilos. O seu cardápio leva o seu nome, as suas cores e o seu
            WhatsApp.
          </p>
        </div>

        <div class="exemplos">
          {
            exemplos.map(({ slug, cfg }) => (
              <a class="exemplo" href={`/${slug}`}>
                <span class="previa">
                  <img
                    src={`/exemplos/${slug}.png`}
                    alt={`Prévia do cardápio de ${cfg.nome}`}
                    width="390"
                    height="826"
                    loading="lazy"
                  />
                </span>
                <div class="corpo">
                  <span class="selo">
                    {cfg.pacote === 'completo' ? 'Pacote completo' : 'Pacote simples'}
                  </span>
                  <h3>{cfg.nome}</h3>
                  <p>{cfg.slogan || 'Cardápio digital'}</p>
                  <span class="abrir">
                    Abrir cardápio
                    <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <p class="nota">
          São páginas de demonstração. O seu cardápio leva o seu nome, suas cores e seu WhatsApp.
        </p>
      </div>
    </section>

    <section class="secao secao-papel" id="pacotes">
      <div class="container">
        <div class="titulo-secao" data-revelar>
          <span class="rotulo"><i></i> Pacotes</span>
          <h2>Escolha o ponto de partida.</h2>
          <p>
            Os dois pacotes incluem link próprio, QR code e pedido no WhatsApp. O que muda é o
            nível de detalhe do cardápio.
          </p>
        </div>

        <div class="pacotes">
          <article class="pacote">
            <h3>Simples</h3>
            <p class="resumo">Para quem quer começar rápido e sem complicação.</p>
            <ul>
              <li>Cardápio com categorias e itens</li>
              <li>Preços e descrições</li>
              <li>Carrinho com envio no WhatsApp</li>
              <li>Link próprio e QR code</li>
              <li>Página leve e responsiva</li>
              <li>Ajustes pelo WhatsApp</li>
            </ul>
            <div class="preco">
              <b>Sob consulta</b>
              <small>Orçamento sem compromisso no WhatsApp.</small>
              <a class="btn btn-contorno" href={ctaOrcamento} data-wa target="_blank" rel="noopener">
                Pedir orçamento
              </a>
            </div>
          </article>

          <article class="pacote destaque">
            <span class="etiqueta">Mais completo</span>
            <h3>Completo</h3>
            <p class="resumo">Para vender mais e passar confiança em cada detalhe.</p>
            <ul>
              <li>Tudo do pacote Simples</li>
              <li>Fotos ou ilustrações dos itens</li>
              <li>Seção “Mais pedidos”</li>
              <li>Entrega, retirada, taxa e horário</li>
              <li>Endereço e formas de pagamento</li>
              <li>Observações por item</li>
            </ul>
            <div class="preco">
              <b>Sob consulta</b>
              <small>Mensalidade sem comissão por pedido.</small>
              <a class="btn btn-primario" href={ctaCompleto} data-wa target="_blank" rel="noopener">
                Quero o completo
              </a>
            </div>
          </article>
        </div>

        <p class="nota">
          Não sabe qual escolher? Manda o seu cardápio no WhatsApp que a gente indica o melhor
          pacote.
        </p>
      </div>
    </section>

    <section class="secao secao-branca" id="duvidas">
      <div class="container">
        <div class="titulo-secao" data-revelar>
          <span class="rotulo"><i></i> Dúvidas</span>
          <h2>Dúvidas comuns.</h2>
          <p>Se a sua não estiver aqui, chama no WhatsApp.</p>
        </div>

        <div class="duvidas">
          {
            faq.map(({ pergunta, resposta }) => (
              <details>
                <summary>{pergunta}</summary>
                <p>{resposta}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao cta-final">
      <div class="container" data-revelar>
        <h2>
          Seu próximo pedido pode começar com um{' '}
          <span class="glitch">link<span class="glitch-copia ciano" aria-hidden="true">link</span><span class="glitch-copia magenta" aria-hidden="true">link</span></span>.
        </h2>
        <p>
          Manda o nome do seu negócio e o cardápio. A gente monta uma prévia e mostra como fica
          antes de você decidir.
        </p>
        <a class="btn btn-primario btn-grande" href={ctaPrincipal} data-wa target="_blank" rel="noopener">
          Chamar no WhatsApp
        </a>
        <small>Atendimento em horário comercial. Sem compromisso.</small>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="container rodape-grade">
      <div class="rodape-marca">
        <Marca tom="claro" />
        <p>Cardápios digitais com pedido direto no WhatsApp. Feito com calma para pequenos negócios.</p>
      </div>

      <nav class="rodape-col" aria-label="Links do rodapé">
        <h2>Navegar</h2>
        <a href="#como-funciona">Como funciona</a>
        <a href="#recursos">Recursos</a>
        <a href="#exemplos">Exemplos</a>
        <a href="#pacotes">Pacotes</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>

      <div class="rodape-col">
        <h2>Contato</h2>
        <a href={ctaPrincipal} data-wa target="_blank" rel="noopener">
          WhatsApp · {site.whatsappExibicao}
        </a>
        {site.instagram && (
          <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
            Instagram
          </a>
        )}
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      </div>
    </div>

    <div class="container rodape-base">
      <span>© {ano} Flowize</span>
      <span>{site.dominio}</span>
    </div>
  </footer>

  <script>
    import { track } from '../lib/track';

    document.querySelectorAll<HTMLElement>('[data-wa]').forEach((link) => {
      link.addEventListener('click', () => track('Clique WhatsApp'));
    });

    const alvos = document.querySelectorAll<HTMLElement>(
      '[data-revelar], .recurso, .passo, .exemplo, .pacote, .duvidas details',
    );
    const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!('IntersectionObserver' in window) || semMovimento) {
      alvos.forEach((alvo) => alvo.classList.add('visivel'));
    } else {
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            entrada.target.classList.add('visivel');
            observador.unobserve(entrada.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
      );

      alvos.forEach((alvo) => observador.observe(alvo));
    }
  </script>
</Base>


<style is:global>
  :root {
    --tinta: #0b0b0f;
    --tinta-2: #1b1b22;
    --papel: #f6f6f8;
    --papel-2: #eeeef2;
    --branco: #fff;
    --acento: #0b0b0f;
    --acento-2: #26262e;
    --ciano: #00d5e8;
    --magenta: #ff2e93;
    --suave: #eaeaef;
    --linha: #e2e2e8;
    --linha-forte: #c8c8d2;
    --mudo: #62626e;
    --verde: #0f9d58;
    --sombra: 0 22px 55px -30px #0b0b0f73;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  body {
    margin: 0;
    background: var(--papel);
    color: var(--tinta);
    font: 16px/1.55 'Instrument Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--magenta);
    color: #fff;
  }

  h1,
  h2,
  h3,
  .display {
    font-family: 'Bricolage Grotesque', 'Instrument Sans', system-ui, sans-serif;
    letter-spacing: -0.03em;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  :focus-visible {
    outline: 3px solid var(--magenta);
    outline-offset: 3px;
  }

  .container {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  .pular {
    position: absolute;
    top: -100px;
    left: 16px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: #fff;
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
  }

  .pular:focus {
    top: 16px;
  }

  /* Header */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--linha);
    background: color-mix(in srgb, var(--papel) 86%, transparent);
    backdrop-filter: blur(14px);
  }

  .cabecalho-interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 72px;
  }

  .nav {
    display: flex;
    gap: 22px;
    font-size: 0.94rem;
    font-weight: 500;
  }

  .nav a {
    position: relative;
    color: var(--mudo);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--ciano), var(--magenta));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav a:hover {
    color: var(--tinta);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  /* Botões */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    font: 600 0.97rem/1 'Instrument Sans', system-ui, sans-serif;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.18s ease,
      transform 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primario {
    background: var(--tinta);
    color: #fff;
  }

  .btn-primario:hover {
    background: var(--tinta-2);
    box-shadow:
      4px 0 0 -1px var(--ciano),
      -4px 0 0 -1px var(--magenta);
  }

  .btn-secundario {
    border-color: var(--tinta);
    background: var(--branco);
    color: var(--tinta);
  }

  .btn-secundario:hover {
    background: var(--tinta);
    color: #fff;
  }

  .btn-contorno {
    border-color: var(--tinta);
    color: var(--tinta);
    background: transparent;
  }

  .btn-contorno:hover {
    background: var(--tinta);
    color: #fff;
  }

  .btn-pequeno {
    padding: 11px 18px;
    font-size: 0.9rem;
  }

  .btn-grande {
    padding: 17px 30px;
    font-size: 1.05rem;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: clip;
    background: var(--papel);
    color: var(--tinta);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#0b0b0f1f 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(115% 85% at 50% 26%, #000 22%, transparent 76%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: -20% -10% auto;
    height: 130%;
    background:
      radial-gradient(36% 42% at 10% 16%, #00d5e83d, transparent 68%),
      radial-gradient(34% 40% at 90% 8%, #ff2e932e, transparent 70%),
      radial-gradient(38% 44% at 72% 82%, #00d5e81f, transparent 72%);
    pointer-events: none;
  }

  .hero-grade {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 56px;
    padding-block: clamp(56px, 8vw, 96px) clamp(64px, 9vw, 112px);
  }

  .hero-texto {
    animation: subir 0.7s 0.05s both;
  }

  .hero-texto h1 {
    max-width: 17ch;
    margin: 20px 0 0;
    font-size: clamp(2.45rem, 5.7vw, 4.35rem);
    font-weight: 800;
    line-height: 0.99;
    letter-spacing: -0.042em;
  }

  .hero-texto p {
    max-width: 46ch;
    margin: 20px 0 0;
    color: var(--mudo);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 13px;
    border: 1px solid var(--linha-forte);
    border-radius: 999px;
    background: var(--branco);
    color: var(--tinta);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    box-shadow: 0 1px 0 #fff inset;
  }

  .eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ciano);
    animation: pulsar 2.6s ease-in-out infinite;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .provas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: var(--mudo);
    font-size: 0.88rem;
  }

  .provas li::before {
    content: '✓';
    margin-right: 7px;
    color: var(--magenta);
    font-weight: 700;
  }

  /* Texto com falha cromática */
  .glitch {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .glitch-copia {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .glitch-copia.ciano {
    color: var(--ciano);
    animation: glitch-ciano 6.5s steps(1) infinite;
  }

  .glitch-copia.magenta {
    color: var(--magenta);
    animation: glitch-magenta 6.5s steps(1) infinite;
  }

  /* Faixa rolante */
  .faixa {
    overflow: hidden;
    border-block: 1px solid var(--tinta);
    background: var(--tinta);
    color: #fff;
  }

  .faixa-trilho {
    display: flex;
    width: max-content;
    animation: correr 30s linear infinite;
  }

  .faixa-bloco {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 13px 14px;
  }

  .faixa-bloco span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .faixa-bloco i {
    width: 6px;
    height: 6px;
    background: var(--ciano);
    transform: rotate(45deg);
  }

  .faixa-bloco span:nth-child(even) i {
    background: var(--magenta);
  }

  /* Seções */
  .secao {
    padding-block: clamp(56px, 8.5vw, 104px);
  }

  .secao-papel {
    background: var(--papel);
  }

  .secao-branca {
    background: var(--branco);
  }

  .secao-suave {
    background: var(--papel-2);
  }

  .titulo-secao {
    max-width: 720px;
  }

  .rotulo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 14px;
    color: var(--mudo);
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .rotulo i {
    width: 16px;
    height: 3px;
    background: linear-gradient(90deg, var(--ciano) 0 50%, var(--magenta) 50% 100%);
  }

  .titulo-secao h2 {
    margin: 0 0 14px;
    font-size: clamp(1.9rem, 4vw, 2.85rem);
    font-weight: 800;
    line-height: 1.06;
  }

  .titulo-secao p {
    max-width: 58ch;
    margin: 0;
    color: var(--mudo);
    font-size: 1.05rem;
  }

  /* Duelo */
  .duelo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }

  .duelo article {
    padding: 28px;
    border: 1px solid var(--linha);
    border-radius: 22px;
    background: var(--branco);
  }

  .duelo article.ruim {
    border-style: dashed;
    background: transparent;
  }

  .duelo article.bom {
    border-color: var(--tinta);
    box-shadow: var(--sombra);
  }

  .duelo h3 {
    margin: 0;
    font-size: 1.18rem;
  }

  .duelo ul {
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .duelo li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--mudo);
    font-size: 0.96rem;
  }

  .marca-x,
  .marca-v {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
  }

  .marca-x {
    background: #f7e0e9;
    color: #b0125c;
  }

  .marca-v {
    background: #d9f8fa;
    color: #0a7f8a;
  }

  /* Recursos */
  .recursos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
  }

  .recurso {
    padding: 24px;
    border: 1px solid var(--linha);
    border-radius: 20px;
    background: var(--branco);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .recurso:hover {
    border-color: var(--tinta);
    box-shadow:
      5px 5px 0 -1px var(--ciano),
      -5px -5px 0 -1px var(--magenta),
      var(--sombra);
    transform: translateY(-4px);
  }

  .recurso .icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    border-radius: 13px;
    background: var(--tinta);
    color: #fff;
    transition: background 0.2s ease;
  }

  .recurso:hover .icone {
    background: linear-gradient(135deg, var(--ciano), var(--magenta));
  }

  .recurso .icone svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .recurso h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
  }

  .recurso p {
    margin: 0;
    color: var(--mudo);
    font-size: 0.94rem;
  }

  .recurso p b {
    color: var(--tinta);
    font-weight: 600;
  }

  /* Passos */
  .passos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
  }

  .passo {
    padding: 28px;
    border: 1px solid var(--linha);
    border-radius: 22px;
    background: var(--branco);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .passo:hover {
    border-color: var(--tinta);
    box-shadow:
      5px 5px 0 -1px var(--ciano),
      -5px -5px 0 -1px var(--magenta),
      var(--sombra);
    transform: translateY(-4px);
  }

  .passo .num {
    display: block;
    margin-bottom: 12px;
    color: transparent;
    font: 800 2.3rem/1 'Bricolage Grotesque', sans-serif;
    -webkit-text-stroke: 1.4px var(--tinta);
    text-shadow:
      3px 0 var(--ciano),
      -3px 0 var(--magenta);
  }

  .passo h3 {
    margin: 0 0 6px;
    font-size: 1.12rem;
  }

  .passo p {
    margin: 0;
    color: var(--mudo);
    font-size: 0.95rem;
  }

  /* Exemplos */
  .exemplos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }

  .exemplo {
    display: flex;
    flex-direction: row;
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: 22px;
    background: var(--branco);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .exemplo:hover {
    border-color: var(--tinta);
    box-shadow:
      5px 5px 0 -1px var(--ciano),
      -5px -5px 0 -1px var(--magenta),
      var(--sombra);
    transform: translateY(-4px);
  }

  .exemplo .previa {
    display: grid;
    flex: 0 0 44%;
    place-items: center;
    padding: 22px 18px;
    border-right: 1px solid var(--linha);
    background:
      radial-gradient(120% 90% at 50% 0%, #dffbfd 0%, transparent 62%),
      radial-gradient(100% 80% at 100% 100%, #ffe3f0 0%, transparent 58%),
      var(--papel-2);
  }

  .exemplo .previa img {
    display: block;
    width: min(190px, 100%);
    height: 300px;
    border: 5px solid var(--tinta);
    border-radius: 22px;
    box-shadow: 0 18px 34px #0b0b0f24;
    object-fit: cover;
    object-position: top center;
  }

  .exemplo .corpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 26px 24px;
  }

  .exemplo .selo {
    align-self: flex-start;
    padding: 4px 10px;
    border: 1px solid var(--linha-forte);
    border-radius: 999px;
    background: var(--papel);
    color: var(--mudo);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .exemplo h3 {
    margin: 4px 0 0;
    font-size: 1.28rem;
  }

  .exemplo p {
    margin: 0;
    color: var(--mudo);
    font-size: 0.94rem;
  }

  .exemplo .abrir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 16px;
    color: var(--tinta);
    font-weight: 600;
    font-size: 0.94rem;
  }

  .exemplo .abrir span {
    transition: transform 0.18s ease;
  }

  .exemplo:hover .abrir span {
    transform: translateX(4px);
  }

  /* Pacotes */
  .pacotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: stretch;
    margin-top: 44px;
  }

  .pacote {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px;
    border: 1px solid var(--linha);
    border-radius: 24px;
    background: var(--branco);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .pacote:hover {
    border-color: var(--tinta);
    box-shadow:
      5px 5px 0 -1px var(--ciano),
      -5px -5px 0 -1px var(--magenta),
      var(--sombra);
    transform: translateY(-4px);
  }

  .pacote.destaque {
    border-color: var(--tinta);
    background: var(--tinta);
    color: #fff;
    box-shadow:
      0 34px 70px -44px #00d5e8,
      0 34px 70px -52px #ff2e93;
  }

  .pacote.destaque:hover {
    box-shadow:
      5px 5px 0 -1px var(--ciano),
      -5px -5px 0 -1px var(--magenta),
      0 34px 70px -44px #00d5e8;
  }

  .pacote .etiqueta {
    position: absolute;
    top: -13px;
    right: 24px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--tinta);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pacote.destaque .etiqueta {
    background: linear-gradient(90deg, var(--ciano), var(--magenta));
    color: var(--tinta);
  }

  .pacote h3 {
    margin: 0;
    font-size: 1.55rem;
  }

  .pacote .resumo {
    margin: 6px 0 20px;
    color: var(--mudo);
    font-size: 0.96rem;
  }

  .pacote.destaque .resumo,
  .pacote.destaque ul {
    color: #b9b9c4;
  }

  .pacote ul {
    display: grid;
    gap: 10px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .pacote li::before {
    content: '✓';
    margin-right: 9px;
    color: var(--verde);
    font-weight: 700;
  }

  .pacote.destaque li::before {
    color: var(--ciano);
  }

  .pacote .preco {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding-top: 22px;
    border-top: 1px solid var(--linha);
  }

  .pacote.destaque .preco {
    border-top-color: #ffffff24;
  }

  .pacote .preco b {
    font: 700 1.4rem 'Bricolage Grotesque', sans-serif;
    letter-spacing: -0.02em;
  }

  .pacote .preco small {
    margin-bottom: 14px;
    color: var(--mudo);
    font-size: 0.88rem;
  }

  .pacote.destaque .preco small {
    color: #9a9aa6;
  }

  .pacote.destaque .btn-primario {
    background: #fff;
    color: var(--tinta);
  }

  .pacote.destaque .btn-primario:hover {
    background: var(--ciano);
    box-shadow:
      4px 0 0 -1px #fff,
      -4px 0 0 -1px var(--magenta);
  }

  .nota {
    max-width: 60ch;
    margin: 26px 0 0;
    color: var(--mudo);
    font-size: 0.92rem;
  }

  /* Dúvidas */
  .duvidas {
    max-width: 820px;
    margin: 34px 0 0;
  }

  .duvidas details {
    padding: 18px 0;
    border-bottom: 1px solid var(--linha);
  }

  .duvidas details:first-child {
    border-top: 1px solid var(--linha);
  }

  .duvidas summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 1.02rem;
  }

  .duvidas summary::-webkit-details-marker {
    display: none;
  }

  .duvidas summary::after {
    content: '+';
    color: var(--magenta);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .duvidas details[open] summary::after {
    transform: rotate(45deg);
  }

  .duvidas p {
    max-width: 70ch;
    margin: 12px 0 0;
    color: var(--mudo);
  }

  /* CTA final */
  .cta-final {
    position: relative;
    overflow: clip;
    background: var(--tinta);
    color: #fff;
    text-align: center;
  }

  .cta-final::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46% 60% at 16% 0%, #00d5e83d, transparent 70%),
      radial-gradient(42% 56% at 86% 100%, #ff2e9333, transparent 72%);
    pointer-events: none;
  }

  .cta-final .container {
    position: relative;
    z-index: 1;
  }

  .cta-final h2 {
    max-width: 20ch;
    margin: 0 auto 16px;
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    font-weight: 800;
    line-height: 1.04;
  }

  .cta-final p {
    max-width: 54ch;
    margin: 0 auto 30px;
    color: #b9b9c4;
    font-size: 1.03rem;
  }

  .cta-final .btn-primario {
    background: #fff;
    color: var(--tinta);
  }

  .cta-final .btn-primario:hover {
    background: var(--ciano);
    box-shadow:
      4px 0 0 -1px #fff,
      -4px 0 0 -1px var(--magenta);
  }

  .cta-final small {
    display: block;
    margin-top: 16px;
    color: #83838f;
    font-size: 0.84rem;
  }

  /* Rodapé */
  .rodape {
    position: relative;
    padding: 52px 0 30px;
    background: #07070a;
    color: #b9b9c4;
  }

  .rodape::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--ciano), var(--magenta));
    opacity: 0.75;
  }

  .rodape-grade {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 36px;
  }

  .rodape-marca p {
    max-width: 36ch;
    margin: 16px 0 0;
    color: #8f8f9c;
    font-size: 0.92rem;
  }

  .rodape-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.92rem;
  }

  .rodape-col h2 {
    margin: 0 0 4px;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rodape-col a {
    color: #b9b9c4;
    text-decoration: none;
  }

  .rodape-col a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--ciano);
    text-underline-offset: 3px;
  }

  .rodape-base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #ffffff1a;
    color: #77778a;
    font-size: 0.84rem;
  }

  /* Entrada suave no scroll */
  .js :is([data-revelar], .recurso, .passo, .exemplo, .pacote, .duvidas details) {
    opacity: 0;
  }

  .js :is([data-revelar], .recurso, .passo, .exemplo, .pacote, .duvidas details).visivel {
    opacity: 1;
    animation: revelar 0.62s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  .js :is(.recursos, .passos, .exemplos, .pacotes, .duvidas) > :nth-child(2) {
    animation-delay: 0.08s;
  }

  .js :is(.recursos, .passos, .exemplos, .pacotes, .duvidas) > :nth-child(3) {
    animation-delay: 0.16s;
  }

