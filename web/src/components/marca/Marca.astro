---
interface Props {
  href?: string;
  tom?: 'escuro' | 'claro';
}

const { href = '/', tom = 'escuro' } = Astro.props;
---

<a class:list={['marca', tom]} href={href} aria-label="Flowize — página inicial">
  <span class="simbolo" aria-hidden="true">
    <svg viewBox="0 0 40 40" role="presentation">
      <g class="camada ciano">
        <circle cx="20" cy="20" r="11"></circle>
        <rect x="3" y="17" width="34" height="6" rx="3"></rect>
      </g>
      <g class="camada magenta">
        <circle cx="20" cy="20" r="11"></circle>
        <rect x="3" y="17" width="34" height="6" rx="3"></rect>
      </g>
      <g class="camada preta">
        <circle cx="20" cy="20" r="11"></circle>
        <rect x="3" y="17" width="34" height="6" rx="3"></rect>
      </g>
      <g class="particulas">
        <rect class="p-ciano" x="1" y="7" width="3" height="1.3" rx="0.65"></rect>
        <rect class="p-magenta" x="35" y="10" width="4" height="1.3" rx="0.65"></rect>
        <rect class="p-magenta" x="2" y="31" width="2.4" height="1.3" rx="0.65"></rect>
        <rect class="p-ciano" x="33" y="33" width="4" height="1.3" rx="0.65"></rect>
      </g>
    </svg>
  </span>
  <span class="nome">Flowize</span>
</a>

<style>
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--marca-cor, #0b0b0f);
    text-decoration: none;
    font-family: 'Bricolage Grotesque', 'Instrument Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.18rem;
    letter-spacing: -0.03em;
  }

  .marca.claro {
    --marca-cor: #fff;
  }

  .simbolo {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
  }

  .simbolo svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .camada {
    transform-box: fill-box;
    transform-origin: center;
  }

  .camada circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
  }

  .camada rect {
    fill: currentColor;
  }

  .camada.ciano {
    color: var(--ciano, #00d5e8);
    opacity: 0.95;
    transform: translate(-1.9px, -1px);
    transition: transform 0.18s ease;
  }

  .camada.magenta {
    color: var(--magenta, #ff2e93);
    opacity: 0.95;
    transform: translate(1.9px, 1px);
    transition: transform 0.18s ease;
  }

  .camada.preta {
    color: var(--marca-cor, #0b0b0f);
  }

  .particulas rect {
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .p-ciano {
    fill: var(--ciano, #00d5e8);
  }

  .p-magenta {
    fill: var(--magenta, #ff2e93);
  }

  .marca:hover .ciano,
  .marca:focus-visible .ciano {
    transform: translate(-3.2px, -1.8px);
  }

  .marca:hover .magenta,
  .marca:focus-visible .magenta {
    transform: translate(3.2px, 1.8px);
  }

  .marca:hover .particulas rect,
  .marca:focus-visible .particulas rect {
    opacity: 1;
  }

  .marca:focus-visible {
    outline: 3px solid var(--magenta, #ff2e93);
    outline-offset: 4px;
    border-radius: 6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .camada,
    .particulas rect {
      transition: none;
    }
  }
</style>
