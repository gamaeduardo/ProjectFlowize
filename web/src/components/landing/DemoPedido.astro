---
import { artSvg } from '../../lib/art';
import { money } from '../../lib/format';
import { site } from '../../lib/site';

const entrega = 6;

const itens = [
  {
    nome: 'Marguerita',
    desc: 'Muçarela e manjericão',
    preco: 42,
    arte: { tipo: 'pizza', cores: ['#b5342b', '#e9e3d0', '#7fa23c'], fundo: 'none' },
  },
  {
    nome: 'Calabresa',
    desc: 'Calabresa e cebola',
    preco: 46,
    arte: { tipo: 'pizza', cores: ['#a3241c', '#d9b48a', '#7a2e1a'], fundo: 'none' },
  },
  {
    nome: 'Guaraná',
    desc: 'Lata 350 ml',
    preco: 6,
    arte: { tipo: 'lata', cores: ['#b5342b', '#e9e3d0'], fundo: 'none' },
  },
];
---

<section
  class="demo"
  id="experimente"
  aria-labelledby="demo-titulo"
  data-demo
  data-whatsapp={site.whatsapp}
  data-entrega={entrega}
>
  <div class="demo-luz" aria-hidden="true"></div>

  <div class="container demo-grade">
    <div class="demo-intro" data-revelar>
      <span class="rotulo demo-rotulo"><i></i> Experimente</span>
      <h2 id="demo-titulo">Faça um pedido<br />de teste.</h2>
      <p>
        É o mesmo caminho que o seu cliente faz: escolhe, monta o carrinho e envia. Nada é cobrado
        e nada sai sem você confirmar.
      </p>

      <ol class="demo-passos">
        <li><b>01</b> Toque em um item para adicionar.</li>
        <li><b>02</b> Veja o carrinho se montar no celular.</li>
        <li><b>03</b> Envie e leia a mensagem pronta no WhatsApp.</li>
      </ol>

      <p class="demo-nota">
        Demonstração com a Pizzaria do João. Ao enviar, o WhatsApp da Flowize abre com o pedido de
        teste já escrito — do jeito que o seu chegaria.
      </p>
    </div>

    <div class="demo-palco">
      <div class="demo-interativo">
        <div class="demo-cardapio" role="group" aria-label="Cardápio de teste">
          <div class="demo-cardapio-topo">
            <span class="demo-mini">Pizzaria do João</span>
            <span class="demo-mini-selo">Aberto</span>
          </div>

          {
            itens.map((item, indice) => (
              <button
                type="button"
                class="demo-item"
                data-add={indice}
                data-nome={item.nome}
                data-preco={item.preco}
                aria-label={`Adicionar ${item.nome} por ${money(item.preco)} ao pedido`}
              >
                <span class="demo-arte" set:html={artSvg(item.arte)} />
                <span class="demo-item-info">
                  <b>{item.nome}</b>
                  <small>{item.desc}</small>
                  <strong>{money(item.preco)}</strong>
                </span>
                <span class="demo-mais" aria-hidden="true">+</span>
              </button>
            ))
          }

          <button type="button" class="demo-resumo" id="demoResumo" hidden>
            <span><b id="demoResumoQtd">0 itens</b> · <b id="demoResumoTotal">R$ 0,00</b></span>
            <span>Ver pedido <i aria-hidden="true">→</i></span>
          </button>

          <p class="demo-dica" id="demoDica">Toque em um item para adicionar</p>
        </div>

        <div class="demo-telefone">
          <div class="demo-tela">
            <div class="demo-topo">
              <span class="demo-volta" aria-hidden="true">‹</span>
              <span class="demo-avatar" aria-hidden="true">PJ</span>
              <span class="demo-contato">
                <b>Pizzaria do João</b>
                <small><i aria-hidden="true"></i> online</small>
              </span>
            </div>

            <div class="demo-corpo">
              <div class="demo-vazio" id="demoVazio">
                <div class="demo-vazio-chat">
                  <div class="demo-balao demo-recebido">Oi! Tudo bem? 👋</div>
                  <div class="demo-balao demo-recebido">
                    Escolha os itens no cardápio ao lado. O pedido chega aqui prontinho.
                  </div>
                </div>
                <div class="demo-vazio-carrinho">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" />
                    <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                  </svg>
                  <b>Seu pedido</b>
                  <small>Toque no + para começar.</small>
                </div>
              </div>

              <div class="demo-carrinho" id="demoCarrinho" hidden>
                <div class="demo-carrinho-topo">
                  <b>Seu pedido</b>
                  <span id="demoQtdTopo">0 itens</span>
                </div>

                <ul class="demo-linhas" id="demoLinhas"></ul>

                <div class="demo-totais">
                  <span>Subtotal <b id="demoSub">{money(0)}</b></span>
                  <span>Entrega <b>{money(entrega)}</b></span>
                  <span class="demo-total">Total <b id="demoTotal">{money(0)}</b></span>
                </div>

                <button type="button" class="demo-enviar" id="demoEnviar">
                  Enviar pedido no WhatsApp
                </button>
              </div>

              <div class="demo-chat" id="demoChat" tabindex="-1" hidden>
                <div class="demo-balao demo-recebido">
                  Recebemos seu pedido de teste! É assim que ele chega no WhatsApp da loja. 👋
                </div>
                <div class="demo-balao demo-enviado" id="demoBalao"></div>
                <div class="demo-digitando" id="demoDigitando" aria-hidden="true">
                  <i></i><i></i><i></i>
                </div>
                <div class="demo-chat-acoes" id="demoChatAcoes" hidden>
                  <a
                    class="demo-wa"
                    id="demoWa"
                    href="#"
                    data-wa
                    target="_blank"
                    rel="noopener"
                  >
                    Abrir no WhatsApp <span aria-hidden="true">↗</span>
                  </a>
                  <button type="button" class="demo-refazer" id="demoRefazer">
                    Fazer outro pedido
                  </button>
                </div>
              </div>
            </div>

            <div class="demo-barra" id="demoBarra">
              <span id="demoBarraTxt">0 itens</span>
              <b id="demoBarraTotal">{money(0)}</b>
            </div>
          </div>
        </div>
      </div>

      <div class="demo-sem-js">
        <b>Seu navegador está sem JavaScript.</b>
        <p>
          O experimento interativo não roda aqui, mas você pode ver o cardápio de exemplo
          funcionando de verdade:
        </p>
        <a class="btn btn-primario" href="/pizzaria-do-joao">Abrir cardápio de exemplo</a>
      </div>

      <p class="demo-sr" id="demoAviso" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  import { esc, money } from '../../lib/format';
  import { track } from '../../lib/track';

  const raiz = document.querySelector<HTMLElement>('[data-demo]');

  if (raiz) {
    const semMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const whatsapp = raiz.dataset.whatsapp || '';
    const entrega = Number(raiz.dataset.entrega || 0);

    const botoes = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-add]'));
    const itens = botoes.map((botao) => ({
      nome: botao.dataset.nome || 'Item',
      preco: Number(botao.dataset.preco || 0),
    }));

    const vazio = raiz.querySelector<HTMLElement>('#demoVazio');
    const carrinhoEl = raiz.querySelector<HTMLElement>('#demoCarrinho');
    const linhasEl = raiz.querySelector<HTMLElement>('#demoLinhas');
    const qtdTopoEl = raiz.querySelector<HTMLElement>('#demoQtdTopo');
    const subEl = raiz.querySelector<HTMLElement>('#demoSub');
    const totalEl = raiz.querySelector<HTMLElement>('#demoTotal');
    const enviarEl = raiz.querySelector<HTMLButtonElement>('#demoEnviar');
    const barra = raiz.querySelector<HTMLElement>('#demoBarra');
    const barraTxt = raiz.querySelector<HTMLElement>('#demoBarraTxt');
    const barraTotal = raiz.querySelector<HTMLElement>('#demoBarraTotal');
    const resumoEl = raiz.querySelector<HTMLButtonElement>('#demoResumo');
    const resumoQtd = raiz.querySelector<HTMLElement>('#demoResumoQtd');
    const resumoTotal = raiz.querySelector<HTMLElement>('#demoResumoTotal');
    const dicaEl = raiz.querySelector<HTMLElement>('#demoDica');
    const corpoEl = raiz.querySelector<HTMLElement>('.demo-corpo');
    const chatEl = raiz.querySelector<HTMLElement>('#demoChat');
    const balaoEl = raiz.querySelector<HTMLElement>('#demoBalao');
    const digitandoEl = raiz.querySelector<HTMLElement>('#demoDigitando');
    const chatAcoes = raiz.querySelector<HTMLElement>('#demoChatAcoes');
    const waEl = raiz.querySelector<HTMLAnchorElement>('#demoWa');
    const refazerEl = raiz.querySelector<HTMLButtonElement>('#demoRefazer');
    const aviso = raiz.querySelector<HTMLElement>('#demoAviso');

    const carrinho = new Map<number, number>();
    let estado: 'carrinho' | 'chat' = 'carrinho';
    let digitacao = 0;

    const linhas = () => [...carrinho.entries()].filter(([, qtd]) => qtd > 0);
    const quantidade = () => linhas().reduce((soma, [, qtd]) => soma + qtd, 0);
    const subtotal = () =>
      linhas().reduce((soma, [indice, qtd]) => soma + itens[indice].preco * qtd, 0);
    const total = () => (quantidade() > 0 ? subtotal() + entrega : 0);
    const plural = (n: number) => `${n} ${n === 1 ? 'item' : 'itens'}`;

    function anunciar(texto: string) {
      if (aviso) aviso.textContent = texto;
    }

    function render() {
      const qtd = quantidade();
      const sub = subtotal();
      const tot = total();

      if (barraTxt) barraTxt.textContent = plural(qtd);
      if (barraTotal) barraTotal.textContent = money(tot);
      if (resumoEl) resumoEl.hidden = qtd === 0;
      if (resumoQtd) resumoQtd.textContent = plural(qtd);
      if (resumoTotal) resumoTotal.textContent = money(tot);
      if (dicaEl) dicaEl.hidden = qtd > 0;
      if (qtdTopoEl) qtdTopoEl.textContent = plural(qtd);
      if (subEl) subEl.textContent = money(sub);
      if (totalEl) totalEl.textContent = money(tot);
      if (enviarEl) enviarEl.disabled = qtd === 0;
      if (barra) barra.classList.toggle('demo-barra-cheia', qtd > 0);

      if (linhasEl) {
        linhasEl.innerHTML = linhas()
          .map(
            ([indice, qtdItem]) => `
              <li class="demo-linha">
                <span class="demo-linha-nome"><b>${qtdItem}×</b> ${esc(itens[indice].nome)}</span>
                <span class="demo-stepper">
                  <button type="button" data-menos="${indice}" aria-label="Diminuir ${esc(
                    itens[indice].nome,
                  )}">−</button>
                  <b>${qtdItem}</b>
                  <button type="button" data-mais="${indice}" aria-label="Aumentar ${esc(
                    itens[indice].nome,
                  )}">+</button>
                </span>
                <span class="demo-linha-preco">${money(itens[indice].preco * qtdItem)}</span>
              </li>`,
          )
          .join('');
      }

      if (estado === 'carrinho') {
        if (vazio) vazio.hidden = qtd > 0;
        if (carrinhoEl) carrinhoEl.hidden = qtd === 0;
        if (chatEl) chatEl.hidden = true;
      } else {
        if (vazio) vazio.hidden = true;
        if (carrinhoEl) carrinhoEl.hidden = true;
        if (chatEl) chatEl.hidden = false;
      }
    }

    function voar(botao: HTMLButtonElement) {
      if (semMovimento || !barra) return;
      const origem = botao.querySelector<HTMLElement>('.demo-arte');
      if (!origem) return;

      const de = origem.getBoundingClientRect();
      const para = barra.getBoundingClientRect();
      const clone = document.createElement('span');
      clone.className = 'demo-voo';
      clone.innerHTML = origem.innerHTML;
      clone.style.left = `${de.left}px`;
      clone.style.top = `${de.top}px`;
      clone.style.width = `${de.width}px`;
      clone.style.height = `${de.height}px`;
      document.body.appendChild(clone);

      const dx = para.left + para.width / 2 - (de.left + de.width / 2);
      const dy = para.top + para.height / 2 - (de.top + de.height / 2);

      requestAnimationFrame(() => {
        clone.style.transform = `translate(${dx}px, ${dy}px) scale(0.18)`;
        clone.style.opacity = '0';
      });

      window.setTimeout(() => clone.remove(), 720);

      barra.classList.remove('demo-pulso');
      void barra.offsetWidth;
      barra.classList.add('demo-pulso');
      window.setTimeout(() => barra.classList.remove('demo-pulso'), 520);
    }

    function adicionar(indice: number, botao: HTMLButtonElement) {
      if (estado === 'chat') {
        estado = 'carrinho';
        if (balaoEl) balaoEl.textContent = '';
      }
      carrinho.set(indice, (carrinho.get(indice) || 0) + 1);
      render();
      voar(botao);
      anunciar(`${itens[indice].nome} adicionado. ${plural(quantidade())} no pedido.`);
    }

    function montarMensagem() {
      const itensTexto = linhas().map(
        ([indice, qtd]) => `${qtd}x ${itens[indice].nome} (${money(itens[indice].preco)})`,
      );

      return [
        'Olá! Quero fazer um pedido 🍕',
        '',
        ...itensTexto,
        '',
        `Subtotal: ${money(subtotal())}`,
        `Entrega: ${money(entrega)}`,
        `Total: ${money(total())}`,
        '',
        'Pedido de teste montado no site da Flowize.',
      ].join('\n');
    }

    function finalizarChat() {
      if (digitandoEl) digitandoEl.hidden = true;
      if (chatAcoes) chatAcoes.hidden = false;
      anunciar('Mensagem pronta. Abra no WhatsApp para enviar o pedido de teste.');
    }

    function digitar(texto: string) {
      window.clearTimeout(digitacao);
      if (!balaoEl) return;

      if (semMovimento) {
        balaoEl.textContent = texto;
        finalizarChat();
        return;
      }

      balaoEl.textContent = '';
      let posicao = 0;

      const passo = () => {
        posicao = Math.min(texto.length, posicao + 3);
        balaoEl.textContent = texto.slice(0, posicao);
        if (corpoEl) corpoEl.scrollTop = corpoEl.scrollHeight;
        if (posicao < texto.length) {
          digitacao = window.setTimeout(passo, 14);
        } else {
          finalizarChat();
        }
      };

      digitacao = window.setTimeout(passo, 320);
    }

    function enviar() {
      if (quantidade() === 0) return;

      const mensagem = montarMensagem();
      if (waEl) {
        waEl.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensagem)}`;
      }

      estado = 'chat';
      render();
      chatEl?.focus({ preventScroll: true });
      if (chatAcoes) chatAcoes.hidden = true;
      if (digitandoEl) digitandoEl.hidden = false;
      anunciar('Pedido montado. Preparando a mensagem.');
      track('Demo: pedido de teste');
      digitar(mensagem);
    }

    function recomecar() {
      window.clearTimeout(digitacao);
      carrinho.clear();
      estado = 'carrinho';
      if (balaoEl) balaoEl.textContent = '';
      if (chatAcoes) chatAcoes.hidden = true;
      render();
      botoes[0]?.focus({ preventScroll: true });
      anunciar('Pedido recomeçado. Escolha os itens novamente.');
    }

    raiz.addEventListener('click', (evento) => {
      const alvo = (evento.target as Element).closest<HTMLElement>('[data-add], [data-mais], [data-menos]');
      if (!alvo) return;

      if (alvo.dataset.add !== undefined) {
        adicionar(Number(alvo.dataset.add), alvo as HTMLButtonElement);
        return;
      }

      if (alvo.dataset.mais !== undefined) {
        const indice = Number(alvo.dataset.mais);
        carrinho.set(indice, (carrinho.get(indice) || 0) + 1);
        render();
        linhasEl
          ?.querySelector<HTMLButtonElement>(`[data-mais="${indice}"]`)
          ?.focus({ preventScroll: true });
        return;
      }

      if (alvo.dataset.menos !== undefined) {
        const indice = Number(alvo.dataset.menos);
        const atual = carrinho.get(indice) || 0;
        if (atual <= 1) carrinho.delete(indice);
        else carrinho.set(indice, atual - 1);
        render();
        linhasEl
          ?.querySelector<HTMLButtonElement>(`[data-menos="${indice}"]`)
          ?.focus({ preventScroll: true });
      }
    });

    enviarEl?.addEventListener('click', enviar);
    refazerEl?.addEventListener('click', recomecar);

    resumoEl?.addEventListener('click', () => {
      raiz.querySelector<HTMLElement>('.demo-telefone')?.scrollIntoView({
        behavior: semMovimento ? 'auto' : 'smooth',
        block: 'center',
      });
      enviarEl?.focus({ preventScroll: true });
    });

    render();
  }
</script>

<style is:global>
  /* Seção */
  .demo {
    position: relative;
    overflow: clip;
    padding-block: clamp(64px, 9vw, 116px);
    background: #07070a;
    color: #fff;
  }

  .demo::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#ffffff14 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: radial-gradient(90% 70% at 62% 40%, #000 10%, transparent 74%);
    pointer-events: none;
  }

  .demo-luz {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 50% at 12% 4%, #00d5e82b, transparent 70%),
      radial-gradient(38% 46% at 94% 92%, #ff2e9324, transparent 72%);
    pointer-events: none;
  }

  .demo-grade {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.74fr 1.26fr;
    align-items: center;
    gap: clamp(36px, 5vw, 64px);
  }

  .demo-rotulo {
    color: #8f8f9c;
  }

  .demo-intro h2 {
    max-width: 15ch;
    margin: 0 0 16px;
    font-size: clamp(2rem, 3.9vw, 2.9rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .demo-intro > p {
    max-width: 42ch;
    margin: 0;
    color: #b9b9c4;
    font-size: 1.03rem;
  }

  .demo-passos {
    display: grid;
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .demo-passos li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: #d8d8e0;
    font-size: 0.94rem;
  }

  .demo-passos b {
    flex: none;
    color: transparent;
    font: 800 1rem/1 'Bricolage Grotesque', sans-serif;
    -webkit-text-stroke: 1px #8f8f9c;
  }

  .demo-nota {
    max-width: 44ch;
    margin: 26px 0 0;
    padding-top: 18px;
    border-top: 1px solid #ffffff1a;
    color: #83838f;
    font-size: 0.82rem;
  }

  /* Palco */
  .demo-palco {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 306px;
    align-items: center;
    gap: 26px;
  }

  .demo-interativo {
    display: none;
  }

  html.js .demo-interativo {
    display: contents;
  }

  .demo-sem-js {
    display: grid;
    grid-column: 1 / -1;
    justify-items: start;
    gap: 10px;
    padding: 28px;
    border: 1px dashed #ffffff2e;
    border-radius: 22px;
    background: #ffffff08;
    color: #b9b9c4;
  }

  .demo-sem-js b {
    color: #fff;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
  }

  .demo-sem-js p {
    max-width: 48ch;
    margin: 0;
  }

  html.js .demo-sem-js {
    display: none;
  }

  .demo-sem-js .btn-primario {
    margin-top: 4px;
    background: #fff;
    color: var(--tinta);
  }

  .demo-sem-js .btn-primario:hover {
    background: var(--ciano);
    box-shadow:
      4px 0 0 -1px #fff,
      -4px 0 0 -1px var(--magenta);
  }

  .demo-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Cardápio */
  .demo-cardapio {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border: 1px solid #ffffff1f;
    border-radius: 22px;
    background: #ffffff08;
    backdrop-filter: blur(6px);
  }

  .demo-cardapio-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 2px 4px 8px;
  }

  .demo-mini {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .demo-mini-selo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #0f9d5824;
    color: #7ee2a8;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-mini-selo::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #37d67a;
  }

  .demo-item {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: 15px;
    background: #ffffff0a;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .demo-item:hover {
    border-color: #ffffff2e;
    background: #ffffff14;
    transform: translateY(-2px);
  }

  .demo-item:active {
    transform: scale(0.985);
  }

  .demo-arte {
    display: block;
    width: 58px;
    height: 58px;
    overflow: hidden;
    border-radius: 11px;
    background: #f3efec;
  }

  .demo-arte svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .demo-item-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .demo-item-info b {
    font-size: 0.88rem;
    font-weight: 600;
  }

